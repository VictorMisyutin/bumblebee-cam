{
  "_comment": "Fleet-wide policy. Identical on every camera. Version-controlled. Overwritten by provision.sh. Per-camera calibration belongs in device.json, never here.",
  "output_base": "/srv/pollinator/images",
  "lowres_width": 640,
  "lowres_height": 480,
  "still_width": 2304,
  "still_height": 1296,
  "motion_threshold": 15,
  "motion_pixels": 480,
  "motion_confirm_frames": 1,
  "cooldown_seconds": 4,
  "background_alpha": 0.05,
  "frame_sleep_seconds": 0.1,
  "warmup_seconds": 2,
  "active_hours_enabled": true,
  "active_hours_start": "07:00",
  "active_hours_end": "19:00",
  "autofocus_enabled": true,
  "autofocus_mode": "manual",
  "autofocus_cycle_before_capture": false,
  "autofocus_continuous_preview": false,
  "still_settle_seconds": 0.3,
  "still_jpeg_quality": 90,
  "still_max_exposure_us": 5000,
  "still_ae_enable": true,
  "still_sharpness": 2.0,
  "still_contrast": 1.15,
  "still_noise_reduction": "off",
  "still_unsharp_amount": 0.0,
  "still_unsharp_radius": 1.0,
  "quality_gate_enabled": false,
  "duplicate_suppression_enabled": true,
  "duplicate_hash_threshold": 5,
  "hard_negative_tracking_enabled": true,
  "hard_negative_save_preview": false,
  "debug_enabled": true,
  "debug_interval_seconds": 300,
  "debug_dirname": "debug_previews",
  "debug_max_files": 200,
  "preview_dirname": "setup_previews",
  "min_free_mb": 500,
  "config_reload_seconds": 60,
  "detector_enabled": false,
  "post_capture_resume_seconds": 1.5
}
